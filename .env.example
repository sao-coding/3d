BETTER_AUTH_SECRET=
# 一定要填「使用者實際會打的網址」，不是容器內部或 localhost：
# - 本機開發：http://localhost:3001
# - 直接用 IP/port 對外：http://你的主機IP:3001
# - 有掛反向代理（nginx/Caddy/Cloudflare Tunnel 等）：填代理後、瀏覽器網址列會出現的那個網址，
#   例如 https://print.yourdomain.com（協定/網域都要對，Better Auth 的 cookie 安全性、
#   Discord 通知裡的報價連結都是照這個組出來的，填錯 Discord 連結會點不開、登入可能也會怪怪的）
BETTER_AUTH_URL=http://localhost:3001
DATABASE_URL=file:./.data/local.db
# 選填：只在容器第一次啟動、資料庫還沒有任何帳號時使用一次，自動建立唯一登入帳號；
# 帳號建立後這幾個變數就不再有作用，之後可以留著或拿掉都沒差
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# 選填：設定後，有新詢價送出時會用 Discord Webhook 通知你
DISCORD_WEBHOOK_URL=
# 選填：如果上面的 webhook 指向論壇頻道，可以設定這兩個標籤 ID，通知會依服務類型自動貼標籤
# （頻道設定 > 標籤，把標籤的 ID 複製過來；沒設定就不會帶標籤，一樣能發文）
DISCORD_TAG_MODELING_ID=
DISCORD_TAG_PRINT_ONLY_ID=
